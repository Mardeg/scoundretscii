            5 'column' 'massive' 'orange' 'big' 'huge'
                [;
                Examine:
                    "It looks like you could climb down it.";
                Climb:
                    <<Go FAKE_D_OBJ>>;
                ]
            6 'pit' '30' 'thirty' 'foot' 'thirty-foot' '30-foot'
                [;
                Examine:
                    "You'll have to climb down to find out anything more...";
                Climb:
                    <<Go FAKE_D_OBJ>>;

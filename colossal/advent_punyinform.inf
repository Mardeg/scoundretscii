Object  At_Window_On_Pit_2 "At Window on Pit"
  with  teleport_name 'window' 'on' 'pit' 'west' 'w//',
        description [;
            print_ret (string) AT_A_LOW_WINDOW, " left. ",
                 (string) MARKS_IN_THE_DUST;
        ],

        name 'batteries' 'fresh',
#Ifnot;
        name 'batteries' 'battery' 'fresh',
#Endif;
        description
            "They look like ordinary batteries. (A sepulchral voice says, ~Still going!~)",
        initial "There are fresh batteries here.",
        before [;
          Count:
            "A pair.";
        ],
        have_been_used false,
  has   pluralname tiny;

